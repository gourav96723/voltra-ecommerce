NODE_ENV=development
PORT=5000

# MongoDB - use local for development, or an Atlas connection string in production
# Local:  mongodb://127.0.0.1:27017/ecommerce_db
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommerce_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_db

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Razorpay (leave blank to disable online payments; Cash on Delivery still works)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (leave blank to disable image upload; you can still paste image URLs manually in the admin panel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The deployed frontend URL, for CORS
CLIENT_URL=http://localhost:5173
